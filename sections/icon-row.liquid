<section class="section section--{{ section.settings.background }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="icon-row">
      {%- for block in section.blocks -%}
        <div class="icon-row__item" {{ block.shopify_attributes }}>
          <span class="icon-row__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon highlights",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "background", "label": "Background", "default": "plain", "options": [ { "value": "plain", "label": "Plain" }, { "value": "surface", "label": "Alternate" }, { "value": "dark", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "item", "name": "Highlight",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "leaf", "info": "leaf, drop, sparkle, shield, truck, heart, sun, moon, flask, bunny, recycle, lock, return, clock, gift, check" },
        { "type": "text", "id": "title", "label": "Title", "default": "Deep hydration" },
        { "type": "text", "id": "text", "label": "Text", "default": "Helps relieve dryness." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon highlights",
      "blocks": [
        { "type": "item", "settings": { "icon": "drop", "title": "Deep hydration", "text": "Helps relieve dryness." } },
        { "type": "item", "settings": { "icon": "sparkle", "title": "Visible glow", "text": "A smoother, radiant look." } },
        { "type": "item", "settings": { "icon": "shield", "title": "Firm-looking skin", "text": "Supports a firmer look." } },
        { "type": "item", "settings": { "icon": "leaf", "title": "Lightweight formula", "text": "Fast-absorbing." } }
      ]
    }
  ]
}
{% endschema %}
