<section class="section">
  <div class="container container--narrow">
    <h1>{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count == 0 -%}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button button--primary" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart">
        {%- for item in cart.items -%}
          <div class="cart__item">
            <a class="cart__image" href="{{ item.url }}">
              {%- if item.image -%}
                {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
              {%- else -%}
                {% render 'bottle-placeholder' %}
              {%- endif -%}
            </a>
            <div class="cart__details">
              <a class="cart__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="cart__variant">{{ item.variant.title }}</p>{%- endunless -%}
              {%- for discount in item.line_level_discount_allocations -%}
                <p class="cart__discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
              {%- endfor -%}
              <label class="cart__qty">
                <span class="visually-hidden">{{ 'cart.quantity' | t }}</span>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
              </label>
              <a class="cart__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <div class="cart__price">
              {%- if item.original_line_price != item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
              <span>{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {%- endfor -%}

        <div class="cart__footer">
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart__discount">{{ discount.title }} (−{{ discount.total_allocated_amount | money }})</p>
          {%- endfor -%}
          <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="cart__note">{{ 'cart.taxes_note' | t }}</p>
          <div class="cart__buttons">
            <button class="button button--outline" type="submit" name="update">{{ 'cart.update' | t }}</button>
            <button class="button button--primary button--large" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart" }
{% endschema %}
