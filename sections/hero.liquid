<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__text">{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary button--large" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600,900,1200,1600' }}
      {%- else -%}
        {% render 'bottle-placeholder', uid: section.id %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Cold-pressed botanical face oil" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glow that starts with three drops" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A featherlight blend of botanical oils for soft, supple, radiant-looking skin." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the oil" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
