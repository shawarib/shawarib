<section class="section section--{{ section.settings.background }}">
  <div class="container split{% if section.settings.image_position == 'right' %} split--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '500,800,1100,1400' }}
      {%- else -%}
        {% render 'bottle-placeholder', file: section.settings.fallback_image %}
      {%- endif -%}
    </div>
    <div class="split__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="benefits benefits--spaced">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="benefits__icon">{% render 'icon', name: block.settings.icon %}</span>
              <span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %} — {{ block.settings.text }}{% endif %}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary" href="{{ section.settings.button_link | default: '#MainContent' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback_image", "label": "Built-in image (used when no image is chosen)", "default": "story-model.jpg", "options": [ { "value": "story-model.jpg", "label": "Model with dropper" }, { "value": "hero-model.jpg", "label": "Model with bottle" }, { "value": "product-box.jpg", "label": "Bottle and box" }, { "value": "box-back.jpg", "label": "Box back" } ] },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "background", "label": "Background", "default": "plain", "options": [ { "value": "plain", "label": "Plain" }, { "value": "surface", "label": "Alternate" }, { "value": "dark", "label": "Dark" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skin that drinks it in" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A lightweight, fast-absorbing formula that deeply nourishes and helps relieve dryness.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "point", "name": "Bullet point",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "check", "info": "leaf, drop, sparkle, shield, truck, heart, sun, moon, flask, bunny, recycle, lock, return, clock, gift, check" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bullet title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
