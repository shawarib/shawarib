{%- liquid
  if section.settings.product != blank
    assign product = section.settings.product
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}

{%- if product == blank -%}
  <section class="section">
    <div class="container product product--empty">
      <div class="product__gallery">
        <div class="product__slide">{% render 'bottle-placeholder', uid: section.id %}</div>
      </div>
      <div class="product__info">
        <h1 class="product__title">Your face oil</h1>
        <p>Choose a product in this section's settings to show it here.</p>
      </div>
    </div>
  </section>
{%- else -%}
<section class="section section--tight" data-product-section data-section-id="{{ section.id }}">
  <div class="container product">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="product__gallery" data-gallery>
      <div class="product__slides" data-gallery-slides>
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="product__slide" data-media-id="{{ media.id }}">
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: media.alt, sizes: '(min-width: 990px) 50vw, 100vw', widths: '500,800,1100,1400' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media.alt, sizes: '(min-width: 990px) 50vw, 100vw', widths: '500,800,1100,1400' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="product__slide">{% render 'bottle-placeholder', uid: section.id %}</div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs" data-gallery-thumbs>
          {%- for media in product.media -%}
            <button type="button" class="product__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Buy box {%- endcomment -%}
    <div class="product__info">
      {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1" data-quantity>

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'rating' -%}
              <div class="product__rating" {{ block.shopify_attributes }}>
                {% render 'stars', count: block.settings.stars %}
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
              </div>

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
                <h1 class="product__title">{{ product.title }}</h1>
              </div>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                <span class="product__price-now" data-price>{{ current_variant.price | money }}</span>
                <s class="product__price-was" data-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
                {%- if block.settings.note != blank -%}<span class="product__price-note">{{ block.settings.note }}</span>{%- endif -%}
              </div>

            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'benefits' -%}
              {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
              <ul class="benefits" {{ block.shopify_attributes }}>
                {%- for line in lines -%}
                  {%- assign item = line | strip -%}
                  {%- if item != blank -%}
                    <li><span class="benefits__icon">{% render 'icon', name: block.settings.icon %}</span><span>{{ item }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variants" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variants__group">
                      <legend>{{ option.name }}</legend>
                      <div class="variants__options">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-opt-' | append: option.position | append: '-' | append: forloop.index -%}
                          <input class="visually-hidden" type="radio" id="{{ input_id }}" name="option-{{ option.position }}" value="{{ value | escape }}" data-option-position="{{ option.position }}"{% if option.selected_value == value %} checked{% endif %}>
                          <label class="variants__pill" for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'bundles' -%}
              <fieldset class="bundles" data-bundles {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <legend class="bundles__heading"><span>{{ block.settings.heading }}</span></legend>
                {%- endif -%}
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign qty_key = 'qty_' | append: i
                    assign title_key = 'title_' | append: i
                    assign sub_key = 'subtitle_' | append: i
                    assign disc_key = 'discount_' | append: i
                    assign badge_key = 'badge_' | append: i
                    assign qty = block.settings[qty_key]
                    assign discount = block.settings[disc_key]
                    assign full = current_variant.price | times: qty
                    assign keep = 100 | minus: discount
                    assign total = full | times: keep | divided_by: 100
                    assign tier_id = section.id | append: '-tier-' | append: i
                    assign i_str = i | append: ''
                  -%}
                  {%- if block.settings[title_key] != blank -%}
                    <input class="visually-hidden" type="radio" name="bundle-tier" id="{{ tier_id }}" value="{{ qty }}" data-tier data-qty="{{ qty }}" data-discount="{{ discount }}"{% if block.settings.selected == i_str %} checked{% endif %}>
                    <label class="bundle" for="{{ tier_id }}">
                      {%- if block.settings[badge_key] != blank -%}<span class="bundle__badge">{{ block.settings[badge_key] }}</span>{%- endif -%}
                      <span class="bundle__radio" aria-hidden="true"></span>
                      <span class="bundle__body">
                        <span class="bundle__title">
                          {{ block.settings[title_key] }}
                          {%- if discount > 0 -%}<span class="bundle__save">{{ 'products.save' | t }} {{ discount }}%</span>{%- endif -%}
                        </span>
                        {%- if block.settings[sub_key] != blank -%}<span class="bundle__subtitle">{{ block.settings[sub_key] }}</span>{%- endif -%}
                      </span>
                      <span class="bundle__price">
                        <span class="bundle__total" data-tier-total>{{ total | money }}</span>
                        <s class="bundle__full" data-tier-full{% if discount == 0 %} hidden{% endif %}>{{ full | money }}</s>
                      </span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
                {%- if block.settings.note != blank -%}<p class="bundles__note">{{ block.settings.note }}</p>{%- endif -%}
              </fieldset>

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                <button class="button button--primary button--full button--large" type="submit" name="add" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                  <span data-add-label>
                    {%- if current_variant.available -%}{{ block.settings.label | default: 'Add to cart' }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p class="product__buy-note">{% render 'icon', name: 'lock' %} {{ block.settings.subtext }}</p>
                {%- endif -%}
              </div>

            {%- when 'trust_icons' -%}
              <ul class="trust" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- assign icon_key = 'icon_' | append: i -%}
                  {%- assign text_key = 'text_' | append: i -%}
                  {%- if block.settings[text_key] != blank -%}
                    <li>{% render 'icon', name: block.settings[icon_key] %}<span>{{ block.settings[text_key] }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'payment_icons' -%}
              <div class="payment-icons payment-icons--center" {{ block.shopify_attributes }}>
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                {%- endfor -%}
              </div>

            {%- when 'guarantee' -%}
              <div class="guarantee-box" {{ block.shopify_attributes }}>
                <span class="guarantee-box__icon">{% render 'icon', name: 'shield' %}</span>
                <div>
                  <p class="guarantee-box__title">{{ block.settings.title }}</p>
                  <p>{{ block.settings.text }}</p>
                </div>
              </div>

            {%- when 'collapsible' -%}
              <details class="accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>
                  <span class="accordion__label">{% render 'icon', name: block.settings.icon %}{{ block.settings.heading }}</span>
                  <span class="accordion__toggle">{% render 'icon', name: 'plus' %}</span>
                </summary>
                <div class="accordion__content rte">
                  {%- if block.settings.use_description -%}{{ product.description }}{%- else -%}{{ block.settings.content }}{%- endif -%}
                </div>
              </details>

          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}
    </div>
  </div>

  {%- if section.settings.sticky_bar -%}
    <div class="sticky-atc" data-sticky-atc hidden>
      <div class="container sticky-atc__inner">
        <div class="sticky-atc__info">
          <p class="sticky-atc__title">{{ product.title }}</p>
          <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
        </div>
        <button class="button button--primary" type="submit" form="{{ form_id }}" data-sticky-button{% unless current_variant.available %} disabled{% endunless %}>
          {%- if current_variant.available -%}{{ section.settings.sticky_label }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
  <script type="application/json" data-product-strings>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "soldOut": {{ 'products.sold_out' | t | json }},
      "unavailable": {{ 'products.unavailable' | t | json }}
    }
  </script>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product buy box",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on product pages. Pick a product to feature it on the home page." },
    { "type": "checkbox", "id": "sticky_bar", "label": "Show sticky add-to-cart bar", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Sticky bar button label", "default": "Add to cart" }
  ],
  "blocks": [
    {
      "type": "rating", "name": "Star rating", "limit": 1,
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "text", "id": "text", "label": "Text", "default": "Customer favourite", "info": "Only state ratings and review counts you can back up." }
      ]
    },
    {
      "type": "title", "name": "Title", "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Small text above title", "default": "Cold-pressed botanical face oil" }
      ]
    },
    {
      "type": "price", "name": "Price", "limit": 1,
      "settings": [
        { "type": "text", "id": "note", "label": "Note next to price", "default": "Taxes included" }
      ]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A featherlight blend of botanical oils that melts in, never sits on top, leaving skin soft, supple and visibly radiant.</p>" }
      ]
    },
    {
      "type": "benefits", "name": "Benefit list",
      "settings": [
        { "type": "textarea", "id": "items", "label": "Benefits (one per line)", "default": "Deep, lasting hydration without the grease\nA soft, healthy-looking glow\nAbsorbs in seconds, layers under makeup\nGentle on every skin type" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
          { "value": "check", "label": "Check" }, { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }
        ] }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "bundles", "name": "Bundle & save", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "The picker sets the quantity and shows the bundle price. To actually charge the lower price, create matching automatic discounts in Shopify admin: Discounts > Create discount > Amount off products > Minimum quantity of items." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Bundle & save" },
        { "type": "select", "id": "selected", "label": "Preselected option", "default": "2", "options": [ { "value": "1", "label": "Option 1" }, { "value": "2", "label": "Option 2" }, { "value": "3", "label": "Option 3" } ] },
        { "type": "header", "content": "Option 1" },
        { "type": "range", "id": "qty_1", "min": 1, "max": 6, "step": 1, "label": "Quantity", "default": 1 },
        { "type": "text", "id": "title_1", "label": "Title", "default": "1 bottle" },
        { "type": "text", "id": "subtitle_1", "label": "Subtitle", "default": "About 8 weeks of daily use" },
        { "type": "range", "id": "discount_1", "min": 0, "max": 50, "step": 1, "unit": "%", "label": "Discount", "default": 0 },
        { "type": "text", "id": "badge_1", "label": "Badge" },
        { "type": "header", "content": "Option 2" },
        { "type": "range", "id": "qty_2", "min": 1, "max": 6, "step": 1, "label": "Quantity", "default": 2 },
        { "type": "text", "id": "title_2", "label": "Title", "default": "2 bottles" },
        { "type": "text", "id": "subtitle_2", "label": "Subtitle", "default": "Morning & night ritual + free shipping" },
        { "type": "range", "id": "discount_2", "min": 0, "max": 50, "step": 1, "unit": "%", "label": "Discount", "default": 10 },
        { "type": "text", "id": "badge_2", "label": "Badge", "default": "Most popular" },
        { "type": "header", "content": "Option 3" },
        { "type": "range", "id": "qty_3", "min": 1, "max": 6, "step": 1, "label": "Quantity", "default": 3 },
        { "type": "text", "id": "title_3", "label": "Title", "default": "3 bottles" },
        { "type": "text", "id": "subtitle_3", "label": "Subtitle", "default": "Best value + free shipping" },
        { "type": "range", "id": "discount_3", "min": 0, "max": 50, "step": 1, "unit": "%", "label": "Discount", "default": 20 },
        { "type": "text", "id": "badge_3", "label": "Badge", "default": "Best value" },
        { "type": "text", "id": "note", "label": "Note under options", "default": "Discount applied automatically at checkout." }
      ]
    },
    {
      "type": "buy_buttons", "name": "Buy buttons", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Add to cart" },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": false },
        { "type": "text", "id": "subtext", "label": "Text under button", "default": "Secure checkout · Ships in 1–2 business days" }
      ]
    },
    {
      "type": "trust_icons", "name": "Trust icons", "limit": 1,
      "settings": [
        { "type": "text", "id": "icon_1", "label": "Icon 1", "default": "truck", "info": "leaf, drop, sparkle, shield, truck, heart, sun, moon, flask, bunny, recycle, lock, return, clock, gift" },
        { "type": "text", "id": "text_1", "label": "Text 1", "default": "Free shipping on 2+" },
        { "type": "text", "id": "icon_2", "label": "Icon 2", "default": "return" },
        { "type": "text", "id": "text_2", "label": "Text 2", "default": "30-day returns" },
        { "type": "text", "id": "icon_3", "label": "Icon 3", "default": "bunny" },
        { "type": "text", "id": "text_3", "label": "Text 3", "default": "Vegan & cruelty-free" }
      ]
    },
    { "type": "payment_icons", "name": "Payment icons", "limit": 1 },
    {
      "type": "guarantee", "name": "Guarantee box", "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "30-day glow guarantee" },
        { "type": "text", "id": "text", "label": "Text", "default": "Try it for 30 days. If your skin doesn't love it, we'll refund you." }
      ]
    },
    {
      "type": "collapsible", "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "text", "id": "icon", "label": "Icon", "default": "leaf" },
        { "type": "checkbox", "id": "use_description", "label": "Show the product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add details here.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product buy box",
      "blocks": [
        { "type": "rating" }, { "type": "title" }, { "type": "price" }, { "type": "benefits" },
        { "type": "variant_picker" }, { "type": "bundles" }, { "type": "buy_buttons" }, { "type": "trust_icons" }, { "type": "guarantee" }
      ]
    }
  ]
}
{% endschema %}
