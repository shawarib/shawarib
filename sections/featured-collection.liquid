<section class="section section--{{ section.settings.background }}">
  <div class="container">
    <div class="section__head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="product-grid">
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="section__sub">Choose a collection in this section's settings.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the ritual" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "select", "id": "background", "label": "Background", "default": "plain", "options": [ { "value": "plain", "label": "Plain" }, { "value": "surface", "label": "Alternate" }, { "value": "dark", "label": "Dark" } ] }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
