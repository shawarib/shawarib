<section class="section section--{{ section.settings.background }}">
  <div class="container">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <figure class="review" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="review__media">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 85vw', widths: '300,500,700' }}</div>
          {%- endif -%}
          {% render 'stars', count: block.settings.stars %}
          {%- if block.settings.title != blank -%}<p class="review__title">{{ block.settings.title }}</p>{%- endif -%}
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            <span class="review__name">{{ block.settings.author }}</span>
            {%- if block.settings.verified -%}<span class="review__verified">{% render 'icon', name: 'check' %} Verified buyer</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer reviews",
  "max_blocks": 9,
  "settings": [
    { "type": "paragraph", "content": "Use real reviews from real customers only." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skin stories" },
    { "type": "select", "id": "background", "label": "Background", "default": "surface", "options": [ { "value": "plain", "label": "Plain" }, { "value": "surface", "label": "Alternate" }, { "value": "dark", "label": "Dark" } ] }
  ],
  "blocks": [
    {
      "type": "review", "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo (optional)" },
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Review title" },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Paste a real customer review here." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Customer name" },
        { "type": "checkbox", "id": "verified", "label": "Show verified buyer badge", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Customer reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
