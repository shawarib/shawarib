<section class="section">
  <div class="container">
    <div class="section__head"><h1>{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <div class="cards cards--3">
        {%- for article in blog.articles -%}
          <article class="card">
            {%- if article.image -%}
              <a class="card__media" href="{{ article.url }}">{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}</a>
            {%- endif -%}
            <div class="card__body">
              <p class="card__tag">{{ article.published_at | date: '%B %d, %Y' }}</p>
              <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
              <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              <a class="link" href="{{ article.url }}">{{ 'blog.read_more' | t }}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
