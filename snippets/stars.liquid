{%- comment -%} Usage: {% render 'stars', count: 5 %} {%- endcomment -%}
{%- assign star_count = count | default: 5 -%}
<span class="stars" role="img" aria-label="{{ star_count }} / 5">
  {%- for i in (1..5) -%}
    <span class="stars__star{% if i > star_count %} stars__star--off{% endif %}">{% render 'icon', name: 'star' %}</span>
  {%- endfor -%}
</span>
